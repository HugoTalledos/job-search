# Copia este archivo a .env (no se sube al repo) y completa los valores.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: token de GitHub de solo lectura para que el perfil incluya tus repos privados.
REPO_READ_TOKEN=

# 1 = al terminar cada corrida, hacer commit y push de data/ y output/ al repo (historial y enlaces en
# las notificaciones). 0 = dejar todo solo en este computador.
JOB_AGENT_GIT_SYNC=1
