# Copia este archivo a .env (no se sube al repo) y completa los valores.
# Según llm.provider en config.yaml: ANTHROPIC_API_KEY (anthropic) u OPENROUTER_API_KEY (openrouter).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: token de GitHub de solo lectura para que el perfil incluya tus repos privados.
REPO_READ_TOKEN=

