# Variables de entorno del agente job-search.
#
# Uso: copia este archivo como .env en la carpeta del proyecto y completa los valores:
#     cp example.env .env && chmod 600 .env
# .env está en .gitignore: tus claves nunca se suben al repositorio. Este archivo (example.env) sí se
# sube, así que no escribas claves reales aquí.

# --- Modelo de lenguaje (OBLIGATORIO: solo la del proveedor que elijas en config.yaml → llm.provider) ---

# llm.provider: anthropic  →  https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# llm.provider: openrouter  →  https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Notificaciones por Telegram (OBLIGATORIO para recibir avisos; sin ellas solo se escriben en el log) ---

# Token del bot: en Telegram habla con @BotFather, envía /newbot y copia el token.
TELEGRAM_BOT_TOKEN=

# Tu chat: escríbele cualquier mensaje a tu bot, abre
#     https://api.telegram.org/bot<TOKEN>/getUpdates
# y copia el número de "chat": {"id": ...}.
TELEGRAM_CHAT_ID=

# --- Opcionales ---

# Token de GitHub de solo lectura (fine-grained, permiso "Contents: Read") para que el perfil también
# analice tus repositorios privados. Sin él solo se leen los públicos.
REPO_READ_TOKEN=

# --- Buscador local con Cloud Firestore ---
# ID del proyecto Firebase que contiene la base Firestore.
FIRESTORE_PROJECT_ID=
# Ruta absoluta al JSON de la cuenta de servicio, guardado fuera de este repositorio.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Webhook del agente remoto ---
# Clave compartida que el cliente enviará en el encabezado X-API-Key.
JOB_AGENT_WEBHOOK_API_KEY=

# Fuerza un modelo para todas las tareas, por encima de llm.model en config.yaml (útil para pruebas).
# JOB_AGENT_MODEL=

# Ruta a otro archivo de configuración en lugar de config.yaml.
# JOB_AGENT_CONFIG=
